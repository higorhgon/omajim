# Maintainer: Higor Henrique Prata Gonçalves <higorlhp2@gmail.com>

pkgname=omajim-qt
pkgver=0.1.0
pkgrel=1
pkgdesc='Cliente XMPP para o Omarchy, com transferência de arquivos SI (Pidgin)'
arch=('x86_64' 'aarch64')
url='https://github.com/higorhgon/omajim'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qxmpp' 'libsecret' 'xdg-desktop-portal' 'wayland')
makedepends=('gcc' 'make' 'git' 'wayland-protocols')
provides=('omajim')
# O Omajim em Python instala o mesmo comando e o mesmo ícone: um ou outro.
conflicts=('omajim-git')
source=()
sha256sums=()

# Uma versão por commit, para o arch-repo recompilar a cada mudança.
pkgver() {
  cd "$startdir/.."
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omajim "$pkgdir/usr/bin/omajim"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omajim.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omajim.svg"
  install -Dm644 "$startdir/omajim.desktop" "$pkgdir/usr/share/applications/omajim.desktop"
  # The tray item names these icons; the omajim.status bar widget reads the
  # status from the name, and other trays draw them.
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/status" "$startdir"/icons/omajim-status-*-symbolic.svg
}
