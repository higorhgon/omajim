#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"

if [ "$(uname -s)" = Darwin ]; then
    "${QMAKE:-qmake6}" "$ROOT/tests/omajim_tests.pro" "QMAKE_APPLE_DEVICE_ARCHS=$(uname -m)"
    make -j"$(getconf _NPROCESSORS_ONLN)"
else
    "${QMAKE:-qmake6}" "$ROOT/tests/omajim_tests.pro"
    make -j"$(nproc)"
fi
QT_QPA_PLATFORM=offscreen ./omajim_tests
